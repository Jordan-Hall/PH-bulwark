#!/usr/bin/env bash
# cloud-init (build_on_instance = true): install Docker + git, BUILD the server image
# from source on the instance (no registry needed), then run it. Slower first boot.
set -euxo pipefail

apt-get update
apt-get install -y docker.io git
systemctl enable --now docker

# Swap so the Rust build doesn't OOM on a small instance.
if [ ! -f /swapfile ]; then
  fallocate -l 4G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# Guardian state + on-box TLS material (same scheme as user_data.sh.tftpl).
mkdir -p /var/lib/bulwark/tls
chmod 700 /var/lib/bulwark /var/lib/bulwark/tls
if [ ! -s /var/lib/bulwark/tls/server.crt ]; then
  TOK=$(curl -s -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')
  PUB_HOST=$(curl -s -H "X-aws-ec2-metadata-token: $TOK" http://169.254.169.254/latest/meta-data/public-hostname)
  PUB_IP=$(curl -s -H "X-aws-ec2-metadata-token: $TOK" http://169.254.169.254/latest/meta-data/public-ipv4)
  # VPCs without DNS hostnames return an empty public-hostname — fall back to
  # the IP so the leaf CN/SAN is never empty ($$ = terraform-escaped $).
  PUB_HOST=$${PUB_HOST:-$PUB_IP}
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
    -keyout /var/lib/bulwark/tls/ca.key -out /var/lib/bulwark/tls/ca.crt \
    -subj '/CN=PH Bulwark Cluster CA' -days 3650
  openssl req -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
    -keyout /var/lib/bulwark/tls/server.key -out /var/lib/bulwark/tls/server.csr \
    -subj "/CN=$PUB_HOST" -addext "subjectAltName=DNS:$PUB_HOST,IP:$PUB_IP"
  openssl x509 -req -in /var/lib/bulwark/tls/server.csr \
    -CA /var/lib/bulwark/tls/ca.crt -CAkey /var/lib/bulwark/tls/ca.key \
    -CAcreateserial -days 825 -copy_extensions copyall \
    -out /var/lib/bulwark/tls/server.crt
  rm -f /var/lib/bulwark/tls/server.csr
  chmod 600 /var/lib/bulwark/tls/ca.key /var/lib/bulwark/tls/server.key
fi
chown -R 10001:10001 /var/lib/bulwark
chown root:root /var/lib/bulwark/tls/ca.key

rm -rf /opt/bulwark-src
git clone --depth 1 ${repo_url} /opt/bulwark-src
cd /opt/bulwark-src
docker build -f deploy/docker/Dockerfile -t bulwark-server:local .

docker run -d --name bulwark-server --restart unless-stopped \
  -p ${bulwark_port}:${bulwark_port} \
  -v /var/lib/bulwark:/var/lib/bulwark \
  -e BULWARK_BIND=0.0.0.0:${bulwark_port} \
  -e BULWARK_ACCOUNTS=1 \
  -e BULWARK_STATE_DIR=/var/lib/bulwark \
  -e BULWARK_TLS_CERT=/var/lib/bulwark/tls/server.crt \
  -e BULWARK_TLS_KEY=/var/lib/bulwark/tls/server.key \
  bulwark-server:local --role all-in-one
