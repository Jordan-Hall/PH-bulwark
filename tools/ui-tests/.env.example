# Midscene needs a vision-capable LLM. Copy this file to `.env` and fill in your
# own values (the harness loads `.env` automatically via dotenv). NEVER commit a
# real key. All values are read from the environment; nothing is hard-coded.
#
# ===========================================================================
# Model config — the documented Midscene "unified" variables (preferred).
# See https://midscenejs.com/android-getting-started.html + /model-provider.html
# ===========================================================================
MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1
MIDSCENE_MODEL_API_KEY=
# A MULTIMODAL / vision model is required — the tests drive the UI by screenshot.
# Examples: gpt-4o, gpt-4.1, qwen-vl-max-latest, doubao-1.5-vision-pro, gemini-2.5-pro.
MIDSCENE_MODEL_NAME=gpt-4o
# Model family hint for non-OpenAI vision models (e.g. qwen-vl, gemini, ui-tars).
# Leave unset for a standard OpenAI gpt-4o/4.1 vision model.
# MIDSCENE_MODEL_FAMILY=qwen-vl
#
# --- Legacy OpenAI-style vars also work if you prefer them ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# ===========================================================================
# Android path (test:child:android) — needs a device/emulator over adb.
# ===========================================================================
# Target device serial (from `adb devices -l`). When unset AND no single device
# is attached, the Android suite is skipped (the web suites still run).
# ANDROID_SERIAL=32161FDH20039M
# Package id of the installed native child app to launch:
CHILD_ANDROID_PACKAGE=co.predatorhunters.bulwark
# Text-input strategy for non-ASCII / stubborn fields (Midscene Android):
# MIDSCENE_ANDROID_IME_STRATEGY=always-yadb
#
# ===========================================================================
# Harness-only overrides (sensible defaults).
# ===========================================================================
# Headed browser for local debugging (default: headless):
# MIDSCENE_HEADED=1
# Override the dev-server ports the web tests serve the apps on:
# CHILD_WEB_PORT=8111
# PARENT_WEB_PORT=8112
# Repo root if you run the harness from outside tools/ui-tests:
# BULWARK_REPO_ROOT=C:\Users\Jordan\child-safety
