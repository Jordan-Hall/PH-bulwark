# Build
/target
**/target
*.log

# Android
platform/android/.gradle
platform/android/build
platform/android/app/build
platform/android/app/src/main/jniLibs
platform/android/local.properties

# Model artifacts (downloaded, checksum-pinned; not vendored)
/models
*.onnx
*.gguf

# Secrets & local state — NEVER commit
*.pem
*.key
*-ca.crt
*.db
*.sqlite
*.sqlcipher
.env
secrets/

# Local Claude Code settings (personal overrides) — never commit
.claude/
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db

# terraform local state (never commit)
deploy/aws/.terraform/
deploy/aws/.terraform.lock.hcl
deploy/aws/*.tfstate
deploy/aws/*.tfstate.backup
deploy/aws/tfplan
