[Unit]
Description=PH Bulwark authenticated Remote VPN peer reconciler
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/bulwark-wg-lease-reconcile /var/lib/bulwark/wg_peers.json
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc/wireguard /run
ReadOnlyPaths=/var/lib/bulwark
