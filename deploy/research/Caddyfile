# Caddy config for research.predatorhunters.co.uk.
#
# Caddy obtains + renews a real Let's Encrypt cert via the Cloudflare DNS-01
# challenge (token in $CF_API_TOKEN, passed by the deploy as a root-only
# env-file). That gives the origin a publicly-trusted cert, so Cloudflare can
# proxy in "Full (strict)" mode. Cert/key state lives in /data (a host volume),
# so renewals survive container restarts. DNS-01 means inbound :80 is NOT needed
# for issuance — but :80 is kept for the HTTP→HTTPS redirect.

{
	email admin@predatorhunters.co.uk
}

# Drop-in site blocks: any *.caddy file mounted into /etc/caddy/conf.d is imported
# here, so extra sites (e.g. tradingfieldguide.co.uk) are added by dropping a file
# on the box — with NO further change to this repo. Imported blocks run inside THIS
# container, so they inherit CF_API_TOKEN for their own DNS-01 certs. An empty or
# absent directory is a harmless no-op.
import /etc/caddy/conf.d/*.caddy

research.predatorhunters.co.uk {
	encode zstd gzip

	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	# Liveness probe (matched before the SPA handler).
	handle /healthz {
		respond "ok" 200
	}

	# Server functions (the waitlist endpoint) go to the Dioxus fullstack server
	# running beside Caddy. If that process is down this 502s and the form falls
	# back to mailto — the rest of the site (served below) is unaffected.
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}

	# Everything else: pre-rendered per-route HTML (SSG), falling back to the
	# SPA shell. `{path}/index.html` serves the pre-rendered page for a route
	# (e.g. /research → /research/index.html); unknown paths hit /index.html and
	# the wasm router renders the 404 page.
	handle {
		root * /srv
		try_files {path} {path}/index.html /index.html
		file_server

		# Long-cache the immutable, content-hashed bundle assets…
		@assets path *.wasm *.js *.css *.woff *.woff2 *.png *.jpg *.jpeg *.svg
		header @assets Cache-Control "public, max-age=604800"
		# …but never cache the HTML (so a redeploy is picked up immediately).
		@html not path *.wasm *.js *.css *.woff *.woff2 *.png *.jpg *.jpeg *.svg *.xml *.txt *.ico
		header @html Cache-Control "no-cache"
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		# CSP. script-src needs 'unsafe-eval' because Dioxus-web's renderer
		# (sledgehammer_bindgen) builds its DOM-op function with `new Function`,
		# which CSP treats as eval — without it the wasm app fails to render
		# after hydration (client-side navigation silently breaks). 'unsafe-inline'
		# is for the three first-party inline scripts (flash-free theme-init + two
		# Dioxus wasm-bootstrap blocks regenerated each build); 'wasm-unsafe-eval'
		# for wasm compilation. Fonts are self-hosted (/fonts/*.woff2), so
		# style-src/font-src stay 'self'. object-src/frame-ancestors/base-uri/
		# form-action are locked down.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}

# ---------------------------------------------------------------------------
# predatorhunters.co.uk (apex) — the main PH Press site. It runs as its OWN
# container (ghcr.io/jordan-hall/ph-press), serving plain HTTP on :8090, joined
# to the shared user-defined Docker network `ph-net` (this research container
# joins it too — see research-site.yml). This edge Caddy terminates TLS for the
# apex (a second Let's Encrypt cert via the SAME Cloudflare DNS-01 token already
# mounted for research) and reverse-proxies to `ph-press:8090` over that network.
# NOTE: it must be the container name, NOT 127.0.0.1 — both run in bridge mode,
# so 127.0.0.1 here is THIS container, not the host or ph-press. Two sites, one
# box, one :443. ph-press owns the app CSP/security headers (passed through
# unchanged); we add HSTS here. If ph-press is down, only the apex 502s —
# research is unaffected (separate site block).
# ---------------------------------------------------------------------------
predatorhunters.co.uk {
	encode zstd gzip

	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}

	handle /healthz {
		respond "ok" 200
	}

	reverse_proxy ph-press:8090 {
		header_up Host {host}
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		-Server
	}
}

# www → apex (canonical 301), TLS via the same DNS-01 token.
www.predatorhunters.co.uk {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	redir https://predatorhunters.co.uk{uri} permanent
}
