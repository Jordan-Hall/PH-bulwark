<?xml version="1.0" encoding="utf-8"?>
<!--
  PH Bulwark Manager — custom AndroidManifest, consumed VERBATIM by dx 0.8 via
  Dioxus.toml `[application].android_manifest` (src/build/android.rs:264-271: when
  set, dx uses this file as-is and skips its handlebars template).

  This is the dx-rendered template (captured from a real android `dx build`
  under target/dx/…) with EXACTLY two additions for native UnifiedPush:
  (NOTE: never write a literal double-hyphen anywhere in this comment — XML
  forbids it inside comments and AGP's manifest parser hard-fails on it.)
    1. <uses-permission POST_NOTIFICATIONS> — to post the content-free alert.
    2. the <service> for our PushService (action PUSH_EVENT) inside <application>.

  Everything else is byte-for-byte the generated manifest, so the activity name,
  lib_name meta-data ("main", matching the WRY_ANDROID_LIBRARY env var dx sets),
  theme and network_security_config stay consistent by construction.

  We deliberately do NOT declare the connector's <queries> or its internal
  receiver here: the Apache-2.0 connector AAR ships those in its own library
  manifest, and AGP/the Android manifest merger folds them in at build time
  (dx's "verbatim" only means dx won't merge its OWN template extras — the
  standard library-manifest merge still runs).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Default permissions -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permissions from Dioxus.toml [permissions] section -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Hardware features from Dioxus.toml [android] section -->

    <!-- Raw manifest XML from Dioxus.toml [android.raw.manifest] -->


    <application android:hasCode="true" android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowNativeHeapPointerTagging="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"


        android:networkSecurityConfig="@xml/network_security_config">
        <activity android:configChanges="orientation|screenLayout|screenSize|keyboardHidden" android:exported="true"
            android:label="@string/app_name" android:launchMode="singleTask" android:name="dev.dioxus.main.MainActivity">
            <meta-data android:name="android.app.lib_name" android:value="main" />
            <meta-data android:name="android.app.func_name" android:value="ANativeActivity_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>


        </activity>

        <!-- Native UnifiedPush receive. The connector library's embedded receiver
             forwards distributor events (NEW_ENDPOINT / MESSAGE / REGISTRATION_FAILED
             / UNREGISTERED) to this bound service via the PUSH_EVENT action. Must NOT
             be exported. Fully-qualified name — namespace (= applicationId
             co.predatorhunters.bulwark.manager) differs from the dev.dioxus.main
             package the class lives in, so a leading-dot ".BulwarkPushService" would
             not resolve. -->
        <service
            android:name="dev.dioxus.main.BulwarkPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
