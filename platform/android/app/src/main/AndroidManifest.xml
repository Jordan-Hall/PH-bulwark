<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AegisApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Material3.DayNight.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The filtering VPN client. Android binds this; it owns the TUN fd and
             hands it to the Rust core (libaegis_client.so) for the real-time
             intercept -> classify -> policy -> block/blur/mute + alert loop. -->
        <service
            android:name=".vpn.AegisVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="child_safety_content_filtering_vpn" />
        </service>

        <!-- On-device conventional text capture for E2E / cert-pinned apps the
             VPN cannot read (WhatsApp, Signal, Messenger secret chats, ...).
             Requires explicit guardian consent in Settings > Accessibility. -->
        <service
            android:name=".accessibility.AegisAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- Approve / "Keep blocked" actions on a guardian alert notification. -->
        <receiver
            android:name=".notify.ReviewActionReceiver"
            android:exported="false" />

        <!-- Tamper-resistance: active device admin can't be uninstalled until it's
             deactivated (friction); deactivation fires a guardian PROTECTION_DISABLED
             alert. Device Owner provisioning (Lockdown.kt) upgrades this to true
             anti-removal. Transparent + consented on the managed child device. -->
        <receiver
            android:name=".admin.AegisDeviceAdminReceiver"
            android:label="@string/device_admin_label"
            android:description="@string/device_admin_description"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
                <!-- Managed-provisioning completion (QR / NFC / zero-touch) and the
                     explicit Device-Owner transition: both finalize enrollment and
                     auto-apply the anti-removal lockdown (see AegisDeviceAdminReceiver). -->
                <action android:name="android.app.action.PROFILE_PROVISIONING_COMPLETE" />
                <action android:name="android.app.action.DEVICE_OWNER_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
