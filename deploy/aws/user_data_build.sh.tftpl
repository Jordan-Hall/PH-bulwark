#!/usr/bin/env bash
# cloud-init (build_on_instance = true): install Docker + git, BUILD the server image
# from source on the instance (no registry needed), then run it. Slower first boot.
set -euxo pipefail

apt-get update
apt-get install -y docker.io git
systemctl enable --now docker

# Swap so the Rust build doesn't OOM on a small instance.
if [ ! -f /swapfile ]; then
  fallocate -l 4G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

mkdir -p /var/lib/bulwark
rm -rf /opt/bulwark-src
git clone --depth 1 ${repo_url} /opt/bulwark-src
cd /opt/bulwark-src
docker build -f deploy/docker/Dockerfile -t bulwark-server:local .

docker run -d --name bulwark-server --restart unless-stopped \
  -p ${bulwark_port}:${bulwark_port} \
  -v /var/lib/bulwark:/var/lib/bulwark \
  -e BULWARK_BIND=0.0.0.0:${bulwark_port} \
  -e BULWARK_ACCOUNTS=1 \
  -e BULWARK_STATE_DIR=/var/lib/bulwark \
  bulwark-server:local --role all-in-one
