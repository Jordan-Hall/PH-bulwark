# Build
/target
**/target
*.log

# Android
platform/android/.gradle
platform/android/build
platform/android/app/build
platform/android/app/src/main/jniLibs
platform/android/local.properties

# Model artifacts (downloaded, checksum-pinned; not vendored)
/models
*.onnx
*.gguf
# Live grooming-model training artifacts — NEVER published (decided: no public
# release of the raw dataset or live weights).
ph-bulwark-grooming-model*
# ...except the small bundled models we DO vendor (compiled in via include_bytes!):
!crates/bulwark-text/models/grooming_detector.onnx
!crates/bulwark-vision/models/nsfw_detector.onnx

# Secrets & local state — NEVER commit
*.pem
*.key
*-ca.crt
*.db
*.sqlite
*.sqlcipher
.env
secrets/

# Local Claude Code settings (personal overrides) — never commit —
# EXCEPT the project agent roster (shared, not personal; docs/agent-workflow.md)
.claude/*
!.claude/agents/

# OS / editor
.DS_Store
Thumbs.db

# terraform local state (never commit)
deploy/aws/.terraform/
deploy/aws/.terraform.lock.hcl
deploy/aws/*.tfstate
deploy/aws/*.tfstate.backup
deploy/aws/tfplan

**/node_modules/