// SCAFFOLD — not built here.
// This Android.bp is illustrative and must be validated against the
// android-16.0.0_r3 Soong build system on a Linux AOSP host before use.
// See platform/rom/README.md for integration instructions.
//
// Licence: Apache-2.0
// SPDX-License-Identifier: Apache-2.0

// libbulwark_safety — the shared content-safety scoring library, linked by:
//   - libcameraservice (camera-gate hook, in-process on the camera hot path)
//   - bulwarkd          (screen/text scan daemon, separate process)
//
// ARCHITECTURE (since PR #223): this IS the Rust core in `rust/`, directly — it
// implements the public C ABI from `include/bulwark_safety.h`
// (bw_init_once / bw_score_nsfw / bw_score_text / bw_model_id). There is NO C++
// wrapper and NO separate `bw_rs_*` binding any more — the old bulwark_safety.cpp
// was removed. Detection is REUSED from the shipping engine (crates/bulwark-vision
// for NSFW, crates/bulwark-text for grooming/adult text), so the ROM never drifts
// from the app.
//
// The .so is built out-of-tree with cargo-ndk (VERIFIED 2026-06-20) — pulling the
// whole Cargo dependency graph (ort + onnxruntime, image, bulwark-*) into Soong is
// impractical, so we vendor the cargo-ndk output as a prebuilt:
//
//   cd platform/rom/libbulwark_safety/rust
//   cargo ndk -t arm64-v8a build --release --features onnx \
//       -o ../prebuilt           # -> ../prebuilt/arm64-v8a/libbulwark_safety.so
//
// What that .so contains (verified): ort's `download-binaries` fetches pyke's
// onnxruntime (ms@1.24.2, aarch64-linux-android) and links it `static=onnxruntime`,
// so the runtime is BAKED IN — there is no separate libonnxruntime.so to ship. The
// ONLY external shared dependency is libc++ (see the libc++ note below).
//
// The NSFW model (crates/bulwark-vision/models/nsfw_detector.onnx, Apache-2.0) is
// installed to /system/etc/bulwark/ via PRODUCT_COPY_FILES and loaded by path, OR
// baked into the .so via include_bytes! (NULL model_path) — see bw_init_once docs.

cc_prebuilt_library_shared {
    name: "libbulwark_safety",

    // The cargo-ndk output. arm64-v8a only for the Pixel 7a (lynx).
    // TODO (Linux host): run the cargo ndk command above, then commit/vendor
    //   prebuilt/arm64-v8a/libbulwark_safety.so (RELEASE build — the debug .so is
    //   ~194 MB; release+strip is far smaller). A release build strips Rust debug
    //   info; the C ABI symbols are #[no_mangle] so they survive.
    srcs: ["prebuilt/arm64-v8a/libbulwark_safety.so"],
    compile_multilib: "64",

    // Expose the C ABI header to callers (libcameraservice, bulwarkd).
    export_include_dirs: ["include"],

    // Do NOT strip: the #[no_mangle] C ABI symbols must remain exported for the
    // callers to resolve them. (A cargo `--release` build already drops Rust debug
    // info; this only prevents Soong from stripping the dynamic symbol table.)
    strip: {
        none: true,
    },

    // libc++ NOTE (host decision): the cargo-ndk .so links the NDK libc++. A system
    // component (libcameraservice) uses the platform libc++. They are compatible at
    // the boundary we use because this library exposes ONLY `extern "C"` symbols — no
    // C++ types cross the boundary — so the platform libc++ satisfies it. If the AOSP
    // build flags an libc++ conflict, build the Rust lib against the platform sysroot
    // or switch to the static archive (libbulwark_safety.a) linked via
    // whole_static_libs into each caller. Validate on Cuttlefish.
    shared_libs: [
        "libc++",
        "liblog",
    ],

    // System partition (not vendor): linked by libcameraservice + bulwarkd.
    vendor_available: false,
}

// NOTE: there is no `cc_library_shared` here any more. Before PR #223 this file
// built a C++ wrapper (bulwark_safety.cpp) over a `bw_rs_*` Rust binding; that
// indirection is gone — the Rust core implements the public ABI directly. If a thin
// C++ shim is ever reintroduced (e.g. to host an NV21/NV12 -> RGBA conversion using
// libyuv before calling bw_score_nsfw), it MUST rename its exports so they do not
// collide with the ABI symbols the Rust .so already exports.
